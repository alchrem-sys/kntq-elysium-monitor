# Variable NAMES only. Never commit real values.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Where alerts go. A public group can be "@name"; a private one needs the
# numeric id (negative) -- run `python tools/get_chat_id.py` to find it.
TELEGRAM_CHAT_ID=
# Numeric user id allowed to run /spread and /pulls. Leave empty to let
# anyone in the chat use them.
TELEGRAM_ADMIN_ID=

# --- Upstash Redis ---
# rediss://... connection string from the Upstash console
REDIS_URL=

# --- LI.FI ---
# Free key at https://portal.li.fi. Without it the public rate limit is low
# enough that the monitor locks itself out for an hour.
LIFI_API_KEY=
LIFI_BASE_URL=https://li.quest/v1

# --- strategy ---
# Size of one round trip, in USD
NOTIONAL_USD=3000
# HyperCore spot taker fee, percent
TAKER_FEE_PCT=0.035
# Alert when the spread reaches this AND an exit is open
GO_SPREAD_PCT=3.0
# Alert at this spread even when every exit is drained
URGENT_SPREAD_PCT=5.0
# An exit counts as usable at or below this loss
MAX_EXIT_LOSS_PCT=1.0
# Hysteresis: re-arm only after the spread falls this far below the trigger
CLEAR_MARGIN_PCT=0.4

# --- which chains to watch ---
# "all" (default) watches every EVM chain with a known USDC, 38 of them.
# Or give an explicit comma list of chain ids.
EXIT_CHAINS=all
# Probes are spent cheapest-known-chain first and stop at the first open exit,
# so these caps only bite when nothing is open anywhere.
PROBES_HOT=12
PROBES_WARM=5
PROBES_COLD=3
# A chain's last reading is treated as unknown again after this many seconds
STALE_SECONDS=1800

# --- polling ---
POLL_SECONDS=120
REQUEST_SPACING_SECONDS=2
ALERT_COOLDOWN_SECONDS=600

# Any address; used only to request quotes, never to sign anything
QUOTE_ADDRESS=0x1111111111111111111111111111111111111111
