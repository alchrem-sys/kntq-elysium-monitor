# Variable NAMES only. Never commit real values.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Where alerts go. A public group can be "@name"; a private one needs the
# numeric id (negative) -- run `python tools/get_chat_id.py` to find it.
TELEGRAM_CHAT_ID=
# Forum topic (supergroup with topics): the number after the chat in t.me/c/<chat>/<topic>
TELEGRAM_THREAD_ID=
# Owner ids, comma separated. Owners can grant others access in the chat
# with /allow (reply to their message). Leave empty to let anyone use the bot.
TELEGRAM_ADMIN_ID=

# --- Pushover ---
# Application API token from pushover.net/apps. The user key is NOT set here:
# send it to the bot with /pushover USER_KEY, it is stored in Redis.
PUSHOVER_APP_TOKEN=
# Default push priority: 1 high, 2 emergency (repeats until acknowledged).
# Changeable in the chat with /pushover priority N.
PUSHOVER_PRIORITY=1

# --- Upstash Redis ---
# rediss://... connection string from the Upstash console
REDIS_URL=

# --- strategy ---
# Default lap size in USD (the pinned message sets its own with /pin)
NOTIONAL_USD=3000
# HyperCore spot taker fee, percent
TAKER_FEE_PCT=0.035
# Hysteresis: re-arm only after the spread falls this far below the trigger
CLEAR_MARGIN_PCT=0.4

# --- polling ---
# Fast spread-only loop, seconds. Changeable in the chat with /poll N.
SPREAD_POLL_SECONDS=10
